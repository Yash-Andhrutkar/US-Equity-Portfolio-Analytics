# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.pem
*.key

# Temporary files
*.tmp
*.log
.cache/

# Packaging / distribution
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Raw / processed market data (regenerated via data_loader.py)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/adjusted_close.csv

# The docs/ directory is the published GitHub Pages site and is tracked in
# full. One of its contents is generated rather than hand-written and must
# stay committed so Pages can serve it:
#   docs/data/dashboard_data.json  - written by scripts/export_dashboard_data.py
# Nothing under docs/ is ignored. This note exists so that file is not
# mistaken for build output and removed.
